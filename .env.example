# Copy to .env — no secrets are needed anywhere in this project.
OLLAMA_HOST=http://127.0.0.1:11434
# Leave empty to use the hardware-based recommendation.
HARVEY_MODEL=
HARVEY_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 1 = block every non-loopback socket connection except explicit web-research fetches
HARVEY_STRICT_LOCAL=1
# Set to 1 only if Ollama runs on another machine YOU own on your LAN (private IPs only)
HARVEY_ALLOW_LAN_OLLAMA=0
HARVEY_QUEUE_WORKER=1
HARVEY_LLM_TIMEOUT=180
